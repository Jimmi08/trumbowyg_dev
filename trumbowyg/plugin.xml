<?xml version="1.0" encoding="utf-8"?>
<e107Plugin name="TrumboWYG" lan="LAN_PLUGIN_TRUMBOWYG_NAME" version="1.1" date="2017-04-26" compatibility="2.0" installRequired="true">
	<author name="Jimako" url=""/>
	<summary lan="LAN_PLUGIN_TRUMBOWYG_SUMM">e107 integration for TrumboWyg - A lightweight WYSIWYG editor</summary>
	<description lan="LAN_PLUGIN_TRUMBOWYG_DESC">Light, translatable and customisable jQuery plugin Beautiful design, generates semantic code, comes with a powerful API</description>
	<category>misc</category>
	<keywords>
		<word>trumbowyg</word>
		<word>editor</word>
		<word>wysiwyg</word>
	</keywords>
	<copyright>GNU/GPL</copyright>
	<adminLinks>
		<link url='admin_config.php' description='LAN_CONFIGURE' icon128="images/trumbowyg.svg" icon='images/trumbowyg.svg' iconSmall='images/trumbowyg.svg' primary='true' >LAN_CONFIGURE</link>
	</adminLinks>
	<pluginPrefs>
        <pref name="enableEditor"></pref>
        <pref name="darkMode"></pref>
 		<pref name="trumbo_semantic">1</pref>
        <pref name="trumbo_linktargets">0</pref>
        <pref name="trumbo_hidebuttontexts">0</pref>
        <pref name="trumbo_changeactivedropdownicon">0</pref>
        <pref name="trumbo_resetcss">0</pref>
        <pref name="trumbo_autogrow">0</pref>
        <pref name="trumbo_imagewidthmodaledit">0</pref>
        <pref name="trumbo_urlprotocol">0</pref>
		<pref name="trumbo_minimallinks'">0</pref>
        <pref name="trumbo_tagclasses"></pref>
        <pref name="removeformatpasted">0</pref>
 		<pref name="tagsToRemove"></pref>
        <pref name="tagsToKeep">hr,img,embed,iframe,input</pref>
        <pref name="allowtagsfrompaste">b,em,i,strong</pref>

      
	</pluginPrefs>
 
</e107Plugin>
